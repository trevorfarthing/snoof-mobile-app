{
  "name": "snoof-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "npx expo run:ios --device",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "migration:create": "supabase migration new",
    "migration:local:reset": "supabase db reset",
    "migration:pull": "supabase db pull",
    "migration:local:up": "supabase migration up",
    "migration:local:down": "supabase migration down",
    "migration:remote:push": "supabase db push",
    "eas:development:ios": "eas build --profile development --platform ios",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:production:ios": "eas build --profile production --platform ios",
    "update-types": "supabase gen types --lang=typescript --project-id \"$PROJECT_REF\" > types/database.types.ts",
    "functions:run:pet-insight": "supabase functions serve generate-pet-insight",
    "functions:deploy": "supabase functions deploy"
  },
  "dependencies": {
